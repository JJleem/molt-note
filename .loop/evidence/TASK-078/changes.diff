+/// 관측된 붕괴처럼 경계가 정확히 30초인 segment 하나. **센티초다** (ADR-0007 §10).
+fn thirty_second_segment(index: i64, text: &str) -> RawSegment {
+    let start_centiseconds = index * 3_000;
+    RawSegment {
+        start_centiseconds,
+        end_centiseconds: start_centiseconds + 2_998,
+        text: Some(format!(" {text}")),
+    }
