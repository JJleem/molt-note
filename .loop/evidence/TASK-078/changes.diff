+            failure.message
+        );
+    }
+    assert!(
+        failure.message.contains("한글자막 by 한효정"),
+        "무엇이 되풀이됐는지가 남아야 한다: {}",
+        failure.message
+    );
+
+    // 기술적 표현에는 판정을 재현할 수 있는 값 전부가 남는다. 비율은 판정 모듈이 낸 값이다.
