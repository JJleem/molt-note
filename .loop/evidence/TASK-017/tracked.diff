+export interface StoppedRecording {
+  /** 저장된 녹음. 목록 화면이 쓰는 값과 같은 모양이다. */
+  readonly recording: Recording;
+  /** 방금 확정된 파일에 대한 사실. */
+  readonly capture: CaptureReport;
