+    assert_eq!(
+        settings::load(&connection)
+            .expect("읽을 수 있어야 한다")
+            .notion_parent_page_id,
+        None
+    );
+    assert_eq!(rows(&connection), 1, "행이 늘지 않는다");
+    close(connection);
