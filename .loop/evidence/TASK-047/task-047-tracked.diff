diff --git a/src-tauri/Cargo.toml b/src-tauri/Cargo.toml
index eb7c087..9ff2994 100644
--- a/src-tauri/Cargo.toml
+++ b/src-tauri/Cargo.toml
@@ -56,11 +56,21 @@ rubato = "5"
 # 호출 하나 때문에 async runtime을 들이지 않는다 (PRODUCT-SPEC §20.5).
 # 쓰는 자리는 `ai::ollama::network` 하나이며, 그 위는 얇은 trait이라 교체 비용이 파일 하나다.
 #
-# `default-features = false`인 이유: 이 Phase는 사용자의 로컬 주소로만 나가므로 **TLS가 필요
-# 없다.** 기본 feature는 rustls/ring을 함께 들여오고, 그것은 Phase 5(Notion·HTTPS)가 실제로
-# 필요해질 때 켜는 것이 맞다 — 지금 켜 두면 미래 의존성 선입금이다 (ADR-0008 §12.2).
-# 버전은 이 Run에서 cargo가 crates.io 인덱스로부터 실제로 해석한 값이다(3.4.0 ·
-# `Cargo.lock`이 checksum까지 고정한다). MSRV는 확인하지 못했다 —
-# `.loop/evidence/TASK-036/verification-log.md`.
-ureq = { version = "3.4", default-features = false }
+# `default-features = false`를 **유지한다** (ADR-0009 §11.2-1) — 기본값을 다시 켜면 압축 ·
+# 쿠키 · 프록시처럼 이 앱이 쓰지 않는 것이 함께 들어온다. 필요한 것만 이름으로 켠다.
+#
+# ★ TLS — Phase 5는 HTTPS로 나간다 (Notion). 그래서 TLS 경로를 **명시적으로 하나 켠다.**
+#   켠 feature 이름:  `rustls`      (ADR-0009 §11.3의 1순위 — 순수 Rust TLS 구현)
+#   확인한 버전:      ureq 3.4.0    (`Cargo.lock`이 checksum까지 고정한다)
+#   루트 인증서 출처: `webpki-roots`(번들된 루트) — `Cargo.lock`이 실제로 무엇을 들여왔는지로
+#                     판정했다. OS 신뢰 저장소를 쓰는 구성이 아니다.
+#   판정 근거:        `.loop/evidence/TASK-047/ureq-tls-verification.md`
+#                     (ADR-0009 §11.4: "feature를 켰다고 적어 두고 lock이 그대로면 켜지지 않은
+#                      것이다" — before는 lock에 TLS crate가 하나도 없는 상태였다)
+# **인증서 검증을 끄는 구성은 없다** — 설정으로도 개발용 플래그로도 두지 않는다 (§11.2-3).
+# token이 실려 나가는 연결이다.
+#
+# MSRV는 확인하지 못했다 — `.loop/evidence/TASK-036/verification-log.md`.
+ureq = { version = "3.4", default-features = false, features = ["rustls"] }
+keyring = { version = "3", default-features = false, features = ["apple-native", "windows-native"] }
 
diff --git a/src-tauri/src/domain/failure.rs b/src-tauri/src/domain/failure.rs
index c27fb98..c0853c3 100644
--- a/src-tauri/src/domain/failure.rs
+++ b/src-tauri/src/domain/failure.rs
@@ -21,13 +21,13 @@ use serde::Serialize;
 
 /// 실패가 어느 종류인지.
 ///
-/// **지금 실제로 만들어지는 것만 있다.** Notion의 실패 종류는 §13에 이미 적혀 있지만, 그
-/// 기능이 존재하는 Phase가 그때 함께 추가한다 — 만들지 않은 실패의 자리를 미리 만들어 두지
+/// **지금 실제로 만들어지는 것만 있다** — 만들지 않은 실패의 자리를 미리 만들어 두지
 /// 않는다 (§20.6). 전사 실패 네 종류는 **전사가 실재하는 Phase 3에서** 그 규칙대로 추가됐고
 /// (`crate::transcription::engine`), AI provider 실패 다섯 종류는 **provider 계약이 실재하는
 /// Phase 4에서** 같은 규칙으로 추가됐다 (`crate::ai::provider`). 여섯 번째인
 /// [`Self::AiInputTooLarge`]는 그보다 늦다 — **요청 전에 크기를 판정하는 실행 순서가 실재하는
-/// 자리에서** 추가됐다 (`crate::ai::run`).
+/// 자리에서** 추가됐다 (`crate::ai::run`). Notion 실패 다섯 종류도 같은 규칙으로 **Notion과
+/// 실제로 말하는 adapter가 실재하는 Phase 5에서** 추가됐다 (`crate::notion::client`).
 #[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize)]
 #[serde(rename_all = "camelCase")]
 pub enum FailureKind {
@@ -94,6 +94,44 @@ pub enum FailureKind {
     /// **provider가 만드는 실패가 아니다.** 만드는 쪽은 요청 전에 크기를 판정하는 실행 순서이며
     /// (`crate::ai::run`), 그래서 `crate::ai::provider::AI_PROVIDER_FAILURE_KINDS`에 없다.
     AiInputTooLarge,
+    /// Notion이 이 앱의 자격증명을 받아들이지 않았다 (§13 `authentication failure` ·
+    /// `docs/ADR-0009-notion-and-export.md` §9.3).
+    ///
+    /// **아래 다섯 Notion 실패도 서로 다른 종류로 남는다.** 전사 실패 넷 · AI 실패 여섯과 같은
+    /// 이유다 — 사용자가 할 수 있는 일이 전부 다르다: token을 다시 넣는 것 · 부모 페이지를
