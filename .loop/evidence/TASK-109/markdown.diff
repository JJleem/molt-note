+/// 주제 섹션 안의 조각 — 한 줄(굵은 소제목 · 글머리표) 또는 표 블록.
+enum TopicChunk {
+    Line(String),
+    Table(String),
+}
+
+/// 문자열 항목 하나를 조각들로 바꾼다.
+///
+/// 보통은 `- <한 줄>` 하나다. 항목 안에 여러 줄로 된 표 문법(머리 행 + `|---|` 구분 행)이
+/// 들어 있으면 그 줄들은 표 블록으로 꺼내고, 앞뒤 글은 각각 글머리표로 남긴다 — 한 줄로
+/// 접혀 `- | a | b | |---|` 같은 글머리표가 생기지 않게 한다. 표로 꺼낼 수 없는 표 문법이
+/// 남으면 [`neutralize_table_syntax`]로 파이프를 무력화한다.
+fn item_chunks(item: &str) -> Vec<TopicChunk> {
+    let lines: Vec<&str> = item.lines().collect();
+    let mut chunks = Vec::new();
+    let mut text: Vec<&str> = Vec::new();
+
+    let mut i = 0;
+    while i < lines.len() {
+        let starts_table = lines[i].trim_start().starts_with('|')
+            && lines.get(i + 1).is_some_and(|next| is_separator_row(next));
+        if !starts_table {
+            text.push(lines[i]);
+            i += 1;
+            continue;
+        }
+
+        push_bullet(&mut chunks, &text.join("\n"));
+        text.clear();
+
+        let columns = split_row(lines[i]);
+        let mut rows = Vec::new();
+        let mut j = i + 2;
+        while j < lines.len() && lines[j].trim_start().starts_with('|') {
+            rows.push(split_row(lines[j]));
+            j += 1;
+        }
+        if let Some(table) = render_table(&columns, &rows) {
+            chunks.push(TopicChunk::Table(table));
+        }
+        i = j;
+    }
+    push_bullet(&mut chunks, &text.join("\n"));
+
+    chunks
+}
+
+/// 글을 한 줄 글머리표로 넣는다. 비어 있으면 넣지 않는다.
+fn push_bullet(chunks: &mut Vec<TopicChunk>, text: &str) {
+    let line = single_line(text);
+    if !line.is_empty() {
+        chunks.push(TopicChunk::Line(format!(
+            "- {}",
+            neutralize_table_syntax(&line)
+        )));
+    }
+}
+
+/// 글머리표 한 줄이 표 문법처럼 보이면(`|`로 시작하거나 `|---`류의 구분 칸이 있으면)
+/// 파이프를 전각 `｜`로 바꾼다. 평범한 글 속의 `A | B`는 건드리지 않는다.
+fn neutralize_table_syntax(line: &str) -> String {
+    let compact: String = line.chars().filter(|c| !c.is_whitespace()).collect();
+    let looks_like_table =
+        compact.starts_with('|') || compact.contains("|-") || compact.contains("|:-");
+    if looks_like_table {
+        line.replace('|', "｜")
+    } else {
+        line.to_owned()
+    }
+}
+
+/// `|---|:--:|` 같은 GFM 구분 행인가.
+fn is_separator_row(line: &str) -> bool {
+    let trimmed = line.trim();
+    if !trimmed.contains('-') || !trimmed.contains('|') {
+        return false;
+    }
+    let inner = trimmed.trim_start_matches('|').trim_end_matches('|');
+    !inner.is_empty()
+        && inner.split('|').all(|cell| {
+            let cell = cell.trim();
+            let core = cell.trim_start_matches(':').trim_end_matches(':');
+            !core.is_empty() && core.chars().all(|c| c == '-')
+        })
+}
+
+/// `| a | b |` 한 행을 칸으로 나눈다. `\|`는 칸 경계가 아니라 글자 `|`다.
+fn split_row(line: &str) -> Vec<String> {
+    let trimmed = line.trim();
+    let trimmed = trimmed.strip_prefix('|').unwrap_or(trimmed);
+    let trimmed = if trimmed.ends_with('|') && !trimmed.ends_with("\\|") {
+        &trimmed[..trimmed.len() - 1]
+    } else {
+        trimmed
+    };
+
+    let mut cells = Vec::new();
+    let mut current = String::new();
+    let mut chars = trimmed.chars().peekable();
+    while let Some(c) = chars.next() {
+        match c {
+            '\\' if chars.peek() == Some(&'|') => {
+                current.push('|');
+                chars.next();
+            }
+            '|' => cells.push(std::mem::take(&mut current).trim().to_owned()),
+            _ => current.push(c),
+        }
+    }
+    cells.push(current.trim().to_owned());
+    cells
+}
+
+/// 열 이름과 행들로 GFM 표 블록(머리 행 · 구분 행 · 데이터 행)을 만든다.
+///
+/// 열이 없으면 `None`. 모자란 칸은 빈 칸으로 채우고, 머리 행보다 많은 칸은 버린다 — 어느
+/// 행이든 열 수가 같아야 표가 깨지지 않는다.
+fn render_table(columns: &[String], rows: &[Vec<String>]) -> Option<String> {
+    let width = columns.len();
+    if width == 0 {
+        return None;
+    }
+
+    let row_line = |cells: Vec<String>| format!("| {} |", cells.join(" | "));
+    let mut lines = vec![
+        row_line(columns.iter().map(|c| table_cell(c)).collect()),
+        row_line(vec!["---".to_owned(); width]),
+    ];
+    for row in rows {
+        lines.push(row_line(
+            (0..width)
+                .map(|k| row.get(k).map(|c| table_cell(c)).unwrap_or_default())
+                .collect(),
+        ));
+    }
+    Some(lines.join("\n"))
+}
+
+/// 표 칸 하나 — 개행(`\n` · `\r\n`)과 공백 덩어리는 공백 하나로 접고, `|`는 `\|`로 막는다.
+/// 칸 안의 `\`는 `\\`로 적어 `\|`가 이스케이프를 풀어 버리지 않게 한다.
+fn table_cell(text: &str) -> String {
+    single_line(text).replace('\\', "\\\\").replace('|', "\\|")
+}
