+/// 사람이 녹음의 어디쯤인지 안다. 1분이 되기 전이면 그렇게 말한다.
+pub fn lost_segment_warning(elapsed: std::time::Duration) -> String {
+    let minutes = elapsed.as_secs() / 60;
