+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub(crate) enum TranscriptShape {
+    /// §11의 모양 — segment 하나가 `### HH:MM:SS` 제목과 그 아래 본문이다.
+    Sectioned,
+    /// AI Handoff가 고르는 모양 — segment 하나가 `HH:MM:SS 문장` 한 줄이다.
+    Compact,
